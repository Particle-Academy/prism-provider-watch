# Provider keys — each unlocks that provider's live model roster.
# Missing keys are SKIPPED (with an actionable note), never fatal. The GitHub
# Atom sources need no keys, so the watcher is useful even with none set.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY=   # accepted as a fallback for Gemini

# --- Optional overrides ---
# Where committed baselines live (default: <repo>/state).
# PRISM_WATCH_STATE_DIR=
# Where drift reports are written (point at the envelope to make them shared
# knowledge, e.g. ../../.ai/knowledge/provider-watch).
# PRISM_WATCH_REPORT_DIR=
# Open a prism issue on drift without passing --issues each run.
# PRISM_WATCH_OPEN_ISSUES=1
# Issue target repo (default: particle-academy/prism).
# PRISM_WATCH_REPO=particle-academy/prism
# HTTP timeout seconds (default: 15).
# PRISM_WATCH_TIMEOUT=15

# --- Workflow integration (Genie + Tynn) ---
# On drift, record a Genie knowledge node (equivalent to the --genie flag).
# PRISM_WATCH_GENIE=1
# On drift, file a Tynn backlog story per provider (equivalent to the --tynn flag).
# PRISM_WATCH_TYNN=1
# Tynn version the drift stories attach to. Omit to auto-resolve the active version.
# PRISM_WATCH_TYNN_VERSION=
# Path to the envelope's .mcp.json (Genie + Tynn endpoints). Default: ../../.mcp.json.
# The Genie URL is also read from $GENIE_MCP_URL when Genie sets it.
# PRISM_WATCH_MCP_CONFIG=
